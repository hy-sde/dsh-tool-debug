{
  "name": "@hy-sde-org/dsh-dap",
  "version": "0.2.1-alpha.4",
  "description": "Debug Adapter Protocol seam for DeepSeek Harness: adapter resolution plus a session manager that launches/attaches, sets breakpoints, steps, inspects threads/stack/variables, and evaluates expressions via spawned adapters (debugpy, lldb-dap, gdb, dlv).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hy-sde/dsh-tool-debug.git",
    "directory": "packages/dap"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-alpha.4"
  },
  "dependencies": {
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-subprocess-local": "^0.2.1-alpha.4",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "deepseek",
    "agent",
    "harness",
    "dsh-plugin",
    "debug",
    "dap",
    "debugger"
  ],
  "homepage": "https://github.com/hy-sde/dsh-tool-debug#readme",
  "bugs": {
    "url": "https://github.com/hy-sde/dsh-tool-debug/issues"
  }
}
